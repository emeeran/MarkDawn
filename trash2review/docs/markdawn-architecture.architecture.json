  "cards": [
    {
      "dot": "cyan",
      "title": "Data Flow & Native Services",
      "items": [
        "Muya json-change → getMarkdown → zustand → debounced write_file",
        "Saves are atomic temp+rename and flush on quit",
        "Menu ids dispatch through the command registry; export shells to pandoc"
      ]
    },
    {
      "dot": "rose",
      "title": "Security Invariants",
      "items": [
        "Keys live in the OS keychain — settings.json holds only isConfigured",
        "FsGuard confines every fs op to consented roots",
        "AI HTTP never runs in the webview — it proxies through Rust"
      ]
    }
